NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
MONGO_URI=mongodb://127.0.0.1:27017/myapp_dev
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:19000
JWT_SECRET=replace-with-your-jwt-secret

